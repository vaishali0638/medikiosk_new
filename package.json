{
  "name": "medikiosk",
  "private": true,
  "version": "0.1.0",
  "description": "MediKiosk \u2014 patient-intake kiosk platform for Indian hospital OPDs",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "services/core_api",
    "services/his_adapter",
    "apps/patient_pwa",
    "apps/doctor_web",
    "apps/governance_web",
    "tools",
    "tests/e2e"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --build --verbose",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test -w @medikiosk/e2e",
    "scan:forbidden": "npm run scan:forbidden -w @medikiosk/tools",
    "tokens:build": "npm run build -w @medikiosk/design-tokens",
    "docker:up": "docker compose -f infra/docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f infra/docker/docker-compose.yml down",
    "docker:logs": "docker compose -f infra/docker/docker-compose.yml logs -f",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run scan:forbidden && npm test",
    "lang:coverage": "npm run lang:coverage -w @medikiosk/tools",
    "start": "bash scripts/start-stack.sh",
    "journey": "npm run journey -w @medikiosk/e2e",
    "supabase:check": "npm run supabase:check -w @medikiosk/core-api",
    "sms:test": "npm run sms:test -w @medikiosk/core-api --",
    "aiworker:check": "npm run aiworker:check -w @medikiosk/core-api"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true
  }
}
