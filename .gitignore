# dependencies
node_modules/
.pnp
.pnp.js

# build output
apps/patient_pwa/next-env.d.ts
dist/
build/
.next/
out/
*.tsbuildinfo

# test / coverage
coverage/
.nyc_output/

# env — never commit real secrets, only *.example files
.env
.env.*
!.env.example
!*.env.example

# secrets / keys
*.pem
*.key
!**/testdata/*.key
secrets/

# logs
*.log
npm-debug.log*
logs/

# OS / editor
.DS_Store
.idea/
*.iml
.vscode/*
!.vscode/extensions.json

# Flutter / Dart
# android/ IS committed: it carries the lock-task MainActivity, the device-admin
# receiver, the HOME intent filter and the backup rules. Regenerating it would silently
# drop every one of those, which is how a kiosk stops being a kiosk.
apps/kiosk_flutter/.dart_tool/
apps/kiosk_flutter/.flutter-plugins
apps/kiosk_flutter/.flutter-plugins-dependencies
apps/kiosk_flutter/build/
apps/kiosk_flutter/ios/Pods/
apps/kiosk_flutter/android/.gradle/
apps/kiosk_flutter/android/local.properties
apps/kiosk_flutter/pubspec.lock

# Python
__pycache__/
*.pyc
.venv/
venv/

# local data volumes
infra/docker/.data/
