{
  "name": "@medikiosk/api-contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Zod schemas and typed contracts shared by API, kiosk and PWA",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build && tsx scripts/generate-openapi.ts",
    "clean": "rm -rf dist *.tsbuildinfo",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "zod-to-json-schema": "^3.24.1"
  }
}
