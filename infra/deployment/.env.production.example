# MediKiosk — production environment template.
#
# NO SECRETS IN THIS FILE, EVER. It is committed. Every value below marked <from Vault>
# is injected at deploy time from the hospital's secret manager; the point of listing them
# here is that a missing one is visible before a node starts, not after.
#
# The application refuses to boot in production with a sandbox adapter selected, so the
# adapter lines are not optional.

# ---- runtime -------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
LOG_LEVEL=log

# Pin a digest, never a tag. `:latest` means two nodes can silently run different code.
MEDIKIOSK_IMAGE=registry.hospital.example/medikiosk/core-api@sha256:<digest>

# ---- data ------------------------------------------------------------------------------
# The hospital's managed or replicated Postgres. Not a container in this stack.
DATABASE_URL=<from Vault>
REDIS_URL=<from Vault>

# ---- object storage --------------------------------------------------------------------
# Documents are encrypted by the application before they are written, so this store holds
# ciphertext. Its durability and backup are still the hospital's to provide.
OBJECT_STORE_ADAPTER=s3
OBJECT_STORE_ENDPOINT=https://s3.ap-south-1.amazonaws.com
OBJECT_STORE_BUCKET=medikiosk-documents

# ---- integrations ----------------------------------------------------------------------
# `sandbox` is refused in production. A real HIS adapter is hospital-specific work.
HIS_ADAPTER=rest
HIS_BASE_URL=https://his.hospital.example/api
SMS_ADAPTER=<hospital gateway>
EMR_EXPORT_ADAPTER=<hospital EMR>
STAFF_IDP=oidc
MALWARE_SCANNER=<scanner>

# ---- keys ------------------------------------------------------------------------------
# Every key is paired with an id. Rotation replaces the key and increments the id; the old
# id stays readable, which is why documents written last year still open.
OBJECT_ENCRYPTION_KEY=<from Vault>
OBJECT_ENCRYPTION_KEY_ID=2026-01
QR_SIGNING_KEY=<from Vault>
QR_SIGNING_KEY_ID=2026-01
# Public halves of retired signing keys, comma separated. Codes issued before a rotation
# keep verifying until they expire; without this, rotating strands every patient holding one.
QR_RETIRED_PUBLIC_KEYS=
OTP_HMAC_SECRET=<from Vault>
OTP_KEY_ID=2026-01
DOCUMENT_LINK_KEY=<from Vault>
OPS_API_KEY=<from Vault>

# ---- browser clients --------------------------------------------------------------------
# The doctor and governance consoles. Without their origins listed, every request they make
# is blocked before it leaves the browser.
CORS_ALLOWED_ORIGINS=https://doctor.hospital.example,https://governance.hospital.example

# ---- feature flags -----------------------------------------------------------------------
# Everything unbuilt or unapproved stays off, and a disabled feature must not render.
# FEATURE_AI_SUMMARY and FEATURE_OCR need a worker that does not ship.
# FEATURE_RED_FLAGS needs hospital-approved deterministic rules that nobody has authored.
FEATURE_ABHA=false
FEATURE_AI_SUMMARY=false
FEATURE_OCR=false
FEATURE_RED_FLAGS=false
FEATURE_VOICE_INTAKE=false

# ---- proxy and monitoring -----------------------------------------------------------------
PROXY_CONF=/etc/medikiosk/nginx.conf
TLS_CERT_DIR=/etc/medikiosk/certs
OPS_API_KEY_FILE=/etc/medikiosk/ops-api-key
