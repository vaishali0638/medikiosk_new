# MediKiosk on Supabase — copy to .env and fill in. No real values in this file.
#
# SUPABASE_SERVICE_ROLE_KEY bypasses row-level security. It belongs to core_api and must
# never reach a browser, a kiosk build, or a git commit.

# ─── Database ────────────────────────────────────────────────────────────────────────
# The DIRECT connection (db.<ref>.supabase.co:5432), not the pooler. Migrations need it.
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
# TLS is derived from the host, so this is only needed to override that.
# DB_SSL=true
# Smaller plans allow few connections; supabase:check prints the budget.
DB_MAX_CONNECTIONS=10

# ─── Supabase project ────────────────────────────────────────────────────────────────
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=medikiosk-documents

# ─── Documents ───────────────────────────────────────────────────────────────────────
# Supabase stores ciphertext; this key never leaves core_api. Lose it and every stored
# document becomes unreadable, so back it up somewhere that is not this repository.
OBJECT_STORE_ADAPTER=supabase
OBJECT_ENCRYPTION_KEY=CHANGE_ME_A_LONG_RANDOM_PASSPHRASE
OBJECT_ENCRYPTION_KEY_ID=v1

# ─── Secrets ─────────────────────────────────────────────────────────────────────────
# openssl rand -hex 32
OTP_HMAC_SECRET=CHANGE_ME_64_HEX_CHARACTERS
OTP_KEY_ID=v1
OPS_API_KEY=CHANGE_ME_AT_LEAST_24_CHARACTERS
# openssl genpkey -algorithm ed25519 -out qr.pem, then paste the PEM
# QR_SIGNING_KEY=

# ─── Integrations ────────────────────────────────────────────────────────────────────
# sandbox logs the OTP instead of sending it. Fine for the MVP; refused in production.
SMS_ADAPTER=sandbox
# SMS_ADAPTER=http
# SMS_API_URL=https://control.msg91.com/api/v5/flow
# SMS_API_KEY=
# SMS_AUTH_HEADER=authkey
# SMS_SENDER_ID=AYUSHK
# SMS_DLT_TEMPLATE_ID=

# The sandbox HIS issues tokens itself. No hospital system is needed for the MVP.
HIS_ADAPTER=sandbox

# ─── Web clients ─────────────────────────────────────────────────────────────────────
# Browsers are blocked before the request leaves without this. The kiosk is native and
# is not subject to CORS.
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:3003

NODE_ENV=development
PORT=3000
