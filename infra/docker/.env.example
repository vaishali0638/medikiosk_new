# Local development values only. Never commit a real .env.
# Copy to infra/docker/.env before running `npm run docker:up`.

POSTGRES_USER=medikiosk
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=medikiosk
POSTGRES_PORT=5432

REDIS_PORT=6379

MINIO_ROOT_USER=medikiosk
MINIO_ROOT_PASSWORD=change_me_locally
MINIO_BUCKET=medikiosk-documents
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

CORE_API_PORT=3000
LOG_LEVEL=log

# Adapter selection. `sandbox` is a local stand-in and is refused in production.
HIS_ADAPTER=sandbox
# HIS_BASE_URL=https://his.hospital.example/api

# Feature flags — everything unbuilt stays off, and a disabled feature must not render.
FEATURE_ABHA=false
FEATURE_AI_SUMMARY=false
FEATURE_OCR=false
FEATURE_RED_FLAGS=false
FEATURE_VOICE_INTAKE=false
