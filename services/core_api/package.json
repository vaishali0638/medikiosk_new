{
  "name": "@medikiosk/core-api",
  "version": "0.1.0",
  "private": true,
  "description": "MediKiosk core platform API (NestJS modular monolith)",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc --build",
    "clean": "rm -rf dist *.tsbuildinfo",
    "start": "node dist/main.js",
    "start:dev": "tsx watch src/main.ts",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "migrate": "node-pg-migrate up -m ../../infra/migrations -j sql --migrations-table schema_migrations",
    "migrate:down": "node-pg-migrate down -m ../../infra/migrations -j sql --migrations-table schema_migrations",
    "migrate:redo": "node-pg-migrate down 6 -m ../../infra/migrations -j sql --migrations-table schema_migrations && node-pg-migrate up -m ../../infra/migrations -j sql --migrations-table schema_migrations",
    "migrate:reset": "tsx scripts/reset-database.ts",
    "seed": "tsx scripts/seed.ts",
    "test:int": "jest --config jest.integration.config.js --runInBand"
  },
  "dependencies": {
    "@medikiosk/api-contracts": "0.1.0",
    "@medikiosk/terminology": "0.1.0",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/swagger": "^8.1.0",
    "@nestjs/terminus": "^10.2.3",
    "helmet": "^8.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1",
    "kysely": "^0.27.5",
    "pg": "^8.13.1",
    "postgres-array": "^3.0.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.15",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "node-pg-migrate": "^7.9.0",
    "@types/pg": "^8.11.10"
  }
}
