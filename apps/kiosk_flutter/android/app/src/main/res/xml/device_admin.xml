<?xml version="1.0" encoding="utf-8"?>
<!-- Device administration policies required for dedicated-device (kiosk) mode. -->
<device-admin xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-policies>
        <limit-password />
        <watch-login />
        <reset-password />
        <force-lock />
        <wipe-data />
        <disable-keyguard-features />
    </uses-policies>
</device-admin>
